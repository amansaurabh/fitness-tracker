# USDA FoodData Central (Optional for local dev, built-in standard fallback included)
USDA_API_KEY="DEMO_KEY"

# Mode
DEMO_MODE="true"

FATSECRET_CLIENT_ID="your-client-id"
FATSECRET_CLIENT_SECRET="your-client-secret"

